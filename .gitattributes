# Auto-normalize text files and enforce LF for documentation and source files
* text=auto

# Force LF for docs, scripts and source files to avoid cross-platform issues
*.md text eol=lf
*.tex text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.kt text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yml text eol=lf
